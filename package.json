{
  "name": "cf-workers-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-user RSS reader with OIDC and shared feed fetching",
  "type": "module",
  "scripts": {
    "check": "wrangler types && tsc --noEmit && tsc -p test/tsconfig.json --noEmit && vitest run",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler d1 migrations apply reader-db --remote && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "types": "wrangler types"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lsongdev/cf-workers-reader.git"
  },
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.11.3",
    "htm": "^3.1.1",
    "jose": "^6.2.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "packageManager": "pnpm@10.30.3"
}
