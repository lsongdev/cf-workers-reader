{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reader",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "vars": {
    "APP_NAME": "Reader",
    "APP_URL": "https://read.lsong.org",
    "OIDC_ISSUER": "https://my.lsong.org",
    "OIDC_CLIENT_ID": "app_PESXQlOpkqYmJq6ZlakO_9Wq"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "70431",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reader-db",
      "database_id": "387f83ed-954c-473f-b1a7-cc8146fe8109",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "read.lsong.org",
      "custom_domain": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FETCH_QUEUE",
        "queue": "reader-fetch"
      }
    ],
    "consumers": [
      {
        "queue": "reader-fetch",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
